npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor / IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
desktop.ini

# lockfiles (optional — uncomment if you don't want to show these)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
